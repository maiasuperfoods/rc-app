# Copy to .env.local. With no Supabase URL set (or DEMO_MODE=true) the app runs on invented demo data.
DEMO_MODE=true
APP_URL=http://localhost:3000

# Supabase (same project as the Private Circle platform)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # workers and OAuth callbacks only

# 32 random bytes, base64:  openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=

# OAuth apps (Shopify's live below, under the App Store block)
META_APP_ID=
META_APP_SECRET=

# Optional
ANTHROPIC_API_KEY=                     # WBR commentary; falls back to the template without it
ANTHROPIC_MODEL=claude-sonnet-4-5
STRIPE_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
EMAIL_FROM=
LIFETIMELY_MCP_URL=
COMMSLAYER_API_URL=https://app.commslayer.com
NEXT_PUBLIC_PRIVATE_CIRCLE_URL=https://privatecircle.renaissancecommerce.com

# Coaching module (Private Circle records live in the admin project)
PC_SUPABASE_URL=                       # https://<admin-project>.supabase.co
PC_SUPABASE_SECRET_KEY=                # admin project secret key (server only)
PC_BASE_URL=https://privatecircle.renaissancecommerce.com   # intake + check-in forms still live there
CAL_BOOKING_URL=
# Fireflies API keys for the coaching accounts, comma-separated — one per coach, since a meeting
# only exists in the workspace of whoever's notetaker joined it.
FIREFLIES_API_KEY=
# Domains treated as the coaching team. Decides which Fireflies meetings may be imported at all.
FOUNDER_DOMAINS=renaissancecommerce.com
# Optional: the exact coach addresses to ask Fireflies about, if a key's workspace roster doesn't
# list them. Leave blank to derive them from the workspace.
COACHING_EMAILS=
# Domains belonging to the ecommerce side of the business. A meeting or booking touching one of
# these is never imported into the coaching database. Comma-separated.
EXCLUDED_DOMAINS=trymaia.co,tryavia.com
ADMIN_EMAIL=admin@renaissancecommerce.com
CRON_SECRET=                           # Vercel Cron → /api/cron/*

# Shopify public app (App Store distribution)
SHOPIFY_CLIENT_ID=                     # Partner dashboard → app → Client ID
SHOPIFY_CLIENT_SECRET=                 # also signs every webhook and OAuth callback
NEXT_PUBLIC_SHOPIFY_CLIENT_ID=         # same value; App Bridge needs it in the browser
SUPPORT_EMAIL=                         # shown on /privacy and in the App Store listing
